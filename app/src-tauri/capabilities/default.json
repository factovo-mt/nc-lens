{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウと起動画面の権限",
  "windows": ["main", "splash"],
  "permissions": ["core:default", "dialog:allow-open", "dialog:allow-save", "dialog:allow-message", "core:window:allow-set-title", "core:window:allow-destroy", "core:window:allow-set-size", "core:window:allow-center", "core:window:allow-unmaximize"]
}
